# Copy to .env and fill in. NEVER put real keys in this file: it is a template and is meant to be committed.

# ---- Core ----
SECRET_KEY=f6bf8bebf74f5fccfc7134f5e7685d3e62cfb8723a4eb00cde0c60e718a140ed                    # long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development            # production on the live server (HTTPS only)

# ---- Database ----
# Local development uses SQLite automatically (instance/mymind.db) if the Turso vars are empty.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Administrator (provisioned once with: flask --app app create-admin) ----
ADMIN_USERNAME=admin@mymind.com
ADMIN_PASSWORD=admin123

# ---- External APIs (leave empty to run in clearly-labelled DEMO mode) ----
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PEXELS_API_KEY=

# ---- Caretaker 18+ ID check (Sumsub). Leave empty = check is OFF (development / tests) ----
# ID_VERIFICATION: empty = auto (on when both Sumsub keys below are set) | off | demo (development only, refused in production) | sumsub
ID_VERIFICATION=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level

# ---- World Library (admin art uploads) ----
# In production point this at PERSISTENT storage (many hosts wipe local disk on every deploy). Empty = instance/world_assets
WORLD_ASSET_DIR=

# ---- AI 3D pipeline (Admin -> AI 3D). Leave keys empty to keep the feature switched off ----
MESHY_API_KEY=
TRIPO_API_KEY=
CONCEPT_PROVIDER=openai          # openai | stability  (2D concept image for characters)
OPENAI_API_KEY=
STABILITY_API_KEY=
# Model names change often: confirm them in each provider's dashboard before relying on the defaults in config.py
# MESHY_MODEL=   TRIPO_MODEL=   OPENAI_IMAGE_MODEL=
AI3D_TARGET_POLYS=12000
AI3D_TEXTURE_SIZE=2048
AI3D_MAX_JOBS_PER_DAY=20
# Unpublished models live here (private, never served to children). Empty = instance/ai3d_private. Use persistent storage in production.
AI3D_PRIVATE_DIR=
